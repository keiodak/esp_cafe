.model DMOD D
.model DLED D(IS=1e-18 N=2)
.subckt OPAMP inp inn out vcc gnd
Bgm 0 int I = 9e-6*tanh(21*(v(inp)-v(inn)))
Cc int 0 30p
Rint int 0 5.3e8
Bo o1 0 V = 0.05 + (v(vcc)-1.55)*0.5*(1+tanh((v(int)-(v(vcc)-1.5)/2)/((v(vcc)-1.55)/2)))
Ro o1 out 50
Ci inp 0 2p
Cn inn 0 2p
.ends
.subckt SW4066 a b ctl vcc gnd
Bs a b I = (v(a)-v(b)) * (1e-9 + 0.005*0.5*(1+tanh(4*(v(ctl)-v(vcc)/2))))
Ca a 0 5p
Cb b 0 5p
.ends
